NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/swasti_natural
MONGODB_DATABASE=swasti_natural
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1h
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false
SUPERADMIN_NAME=Super Administrator
SUPERADMIN_EMAIL=superadmin@gmail.com
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@gmail.com
# Set SUPERADMIN_PASSWORD and ADMIN_PASSWORD in the ignored .env file (8+ characters).
# Both accounts are created automatically on server startup if they do not exist.